# Vue CLI solo expone al frontend las variables que empiezan con VUE_APP_

# URL del backend. /api pasa por el proxy de vue.config.js hacia json-server (puerto 3000),
# por eso funciona igual en local y en GitHub Codespaces.
VUE_APP_API_URL=/api

# Datos de la tienda
VUE_APP_NOMBRE_TIENDA=PARA TI
VUE_APP_MONEDA=Bs.
