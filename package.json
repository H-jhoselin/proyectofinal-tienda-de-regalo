{
  "name": "para-ti",
  "version": "1.0.0",
  "private": true,
  "description": "PARA TI - Tienda de regalos con catálogo y reservas (Práctica 2 Vue3)",
  "scripts": {
    "serve": "concurrently -k -n api,web -c magenta,cyan \"npm:api\" \"npm:web\"",
    "web": "vue-cli-service serve",
    "api": "json-server --watch db.json --port 3000",
    "build": "vue-cli-service build"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "core-js": "^3.45.1",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-plugin-router": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "json-server": "0.17.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
